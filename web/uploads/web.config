<?xml version="1.0" encoding="UTF-8"?>
<!--
  Place this file at: C:\DEV\DataForge\web\uploads\web.config
  (create the file if the uploads folder doesn't already have one)

  This overrides the site-wide rewrite rule for everything under
  /uploads/ specifically, telling IIS "these are real files, serve them
  directly" instead of letting the root web.config's rewrite rule send
  the request into index.php -> Yii2's router, which has no route for
  an arbitrary image path and so fails silently (broken image icon,
  or the "site can't be reached" behavior you saw on downloads).
-->
<configuration>
  <system.webServer>
    <handlers>
      <clear />
      <add name="StaticFile" path="*" verb="*" modules="StaticFileModule" resourceType="File" requireAccess="Read" />
    </handlers>
    <staticContent>
      <remove fileExtension=".csv" />
      <mimeMap fileExtension=".csv" mimeType="text/csv" />
      <remove fileExtension=".ipynb" />
      <mimeMap fileExtension=".ipynb" mimeType="application/json" />
    </staticContent>
    <!-- No rewrite rules here at all — this folder is exempt from the site's PHP routing. -->
  </system.webServer>
</configuration>